# Local training credentials only; .env is ignored by Git and Docker build.
POSTGRES_DB=tbonk
POSTGRES_USER=tbonk
POSTGRES_PASSWORD=tbonk-local
PORT=8000
HOST_PORT=8000
WEB_CONCURRENCY=1
# For running Python outside Compose, export DATABASE_URL explicitly:
# DATABASE_URL=postgresql://tbonk:tbonk-local@localhost:5432/tbonk
